# .env.example - Copy this to .env and fill in your values

# Required: OpenRouter API key
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: PostgreSQL connection string (can also be provided via CLI input)
# Format: postgresql://username:password@host:port/database
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# Alternative legacy key also supported:
# PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/mydb

# Optional: PostHog integration
# POSTHOG_API_KEY=your_posthog_api_key_here
# POSTHOG_PROJECT_ID=your_posthog_project_id_here
# POSTHOG_HOST=https://eu.i.posthog.com
